{
  "$schema": "https://turbo.build/schema.json",
  "ui": "stream",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".output/**"]
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": ["coverage/**"]
    },
    "@mossa/api#test": {
      "dependsOn": ["^build", "@mossa/app#build"],
      "outputs": ["coverage/**"]
    },
    "@mossa/domain#build": { "outputs": [] },
    "@mossa/protocol#build": { "outputs": [] },
    "@mossa/ui#build": { "outputs": [] },
    "lint": {},
    "dev": {
      "cache": false,
      "persistent": true
    },
    "clean": {
      "cache": false
    }
  }
}
