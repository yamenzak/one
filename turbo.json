{
  "$schema": "https://turbo.build/schema.json",
  "ui": "stream",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".output/**"]
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": ["coverage/**"]
    },
    // ⚠️ A worker's integration suite depends on its SPA's BUILD, and turbo
    // cannot infer that: an `assets.directory` is a filesystem path, not a
    // package dependency, so nothing in the graph connects the two. Without the
    // edge the suite boots Miniflare against a missing directory and aborts
    // reporting "no tests" — a PASS-shaped result. That is what turned the merge
    // adding `apps/tessa-app` red, and it is why both CI workflows also build
    // every SPA explicitly.
    //
    // Declaring it here is what makes a bare `turbo run test` correct, and — the
    // reason it was worth doing now — CACHEABLE: the SPA build lands in turbo's
    // cache with everything else instead of being a 24-second `pnpm --filter`
    // outside the graph on every run.
    "@kova/api#test": {
      "dependsOn": ["^build", "@kova/app#build"],
      "outputs": ["coverage/**"]
    },
    "@4dl/tessa#test": {
      "dependsOn": ["^build", "@tessa/app#build"],
      "outputs": ["coverage/**"]
    },
    "e2e": {
      // The worker serves apps/app/dist, so the SPA must be built first — same
      // ordering the api integration suite needs.
      "dependsOn": ["@kova/app#build"],
      "cache": false,
      // Turbo filters the environment. Playwright locates its browsers through
      // PLAYWRIGHT_BROWSERS_PATH (pre-set on CI images and sandboxes); stripped,
      // it reports "please run playwright install" and every spec fails.
      "passThroughEnv": ["PLAYWRIGHT_*", "CI", "E2E_SERVER_LOGS", "NODE_OPTIONS"]
    },
    // The screenshot sweep serves the same built SPA, and it PHOTOGRAPHS it —
    // so a stale `dist` here does not fail, it produces convincing pictures of
    // the previous design and files them under the current names. That happened
    // once, silently, and it is the worst failure mode available to a suite
    // whose whole job is evidence.
    "shots": {
      "dependsOn": ["@kova/app#build"],
      "cache": false,
      "passThroughEnv": ["PLAYWRIGHT_*", "CI", "E2E_SERVER_LOGS", "NODE_OPTIONS"]
    },
    "@4dl/core#build": { "outputs": [] },
    "@4dl/tenancy#build": { "outputs": [] },
    "@4dl/auth#build": { "outputs": [] },
    "@4dl/billing#build": { "outputs": [] },
    "@4dl/commerce#build": { "outputs": [] },
    "@4dl/storage#build": { "outputs": [] },
    "@4dl/ai#build": { "outputs": [] },
    "@4dl/email#build": { "outputs": [] },
    "@4dl/notify#build": { "outputs": [] },
    "@4dl/purge#build": { "outputs": [] },
    "@kova/domain#build": { "outputs": [] },
    "@kova/protocol#build": { "outputs": [] },
    "@4dl/ui#build": { "outputs": [] },
    "@4dl/app-kit#build": { "outputs": [] },
    "lint": {},
    "dev": {
      "cache": false,
      "persistent": true
    },
    "clean": {
      "cache": false
    }
  }
}
