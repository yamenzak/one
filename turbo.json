{
  "$schema": "https://turbo.build/schema.json",
  "ui": "stream",
  // ⚠️ TURBO SANITISES THE ENVIRONMENT, AND THAT SILENTLY DISARMED A TEST SUITE.
  // `@engine/design`'s rhythm harness measures real geometry in real Chromium;
  // the browser lives at `PLAYWRIGHT_BROWSERS_PATH` in this image, and without
  // the variable Playwright looks in its default cache, finds nothing, and the
  // whole file fails to load. Run on its own filter it passed — which is the
  // worst version of this: green where a person looks, red only in the run
  // nobody reads to the bottom of.
  "globalPassThroughEnv": ["PLAYWRIGHT_BROWSERS_PATH", "PLAYWRIGHT_SKIP_BROWSER_DOWNLOAD"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".output/**"]
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": ["coverage/**"]
    },
    // ⚠️ A worker's integration suite depends on its SPA's BUILD, and turbo
    // cannot infer that: an `assets.directory` is a filesystem path, not a
    // package dependency, so nothing in the graph connects the two. Without the
    // edge the suite boots Miniflare against a missing directory and aborts
    // reporting "no tests" — a PASS-shaped result. That is what turned the merge
    // adding a second app's SPA red, and it is why both CI workflows also build
    // every SPA explicitly.
    //
    // Declaring it here is what makes a bare `turbo run test` correct, and — the
    // reason it was worth doing now — CACHEABLE: the SPA build lands in turbo's
    // cache with everything else instead of being a 24-second `pnpm --filter`
    // outside the graph on every run.
    // The same edge, on the framework's own deployment. `@engine/worker` serves
    // `engine/one-space/dist`; without the build its suite boots Miniflare against
    // a missing directory and aborts reporting "no tests", which reads as a
    // pass. Nothing in the dependency graph connects them — an
    // `assets.directory` is a filesystem path.
    //
    // ⚠️ THIS NAMED `@one/one` AND `@one/one-space` FOR AS LONG AS THE PACKAGES
    // HAVE BEEN `@engine/*`. Turbo ignores a task key for a package it does not
    // have, silently, so the edge this paragraph argues for did not exist — and
    // it stayed invisible because a `dist` from an earlier build was always
    // lying around. The suite was running against whatever SPA was last built,
    // which on a stale checkout is a different product than the one under test.
    "@engine/worker#test": {
      "dependsOn": ["^build", "@engine/space#build"],
      "outputs": ["coverage/**"]
    },
    // ⚠️ AND SO DOES THE DESIGN SYSTEM'S OWN SUITE, FOR A DIFFERENT REASON.
    // `test/rhythm.test.tsx` measures spacing in real Chromium against the CSS
    // that actually SHIPS — Tailwind emits only the classes it finds written
    // down, so a stylesheet compiled for the harness would be a different
    // stylesheet from the one the product serves, and a spacing rule verified
    // against CSS nobody sends is worth nothing. It reads `one-space/dist`.
    "@engine/design#test": {
      "dependsOn": ["^build", "@engine/space#build"],
      "outputs": ["coverage/**"]
    },
    // ⚠️ AND A PRODUCT'S OWN GEOMETRY SWEEP, FOR THE SAME REASON ONE LEVEL UP.
    // `apps/inventory` measures every screen it declares against the shipped
    // stylesheet, so it reads `one-space/dist` exactly as the design suite does
    // — and without this edge it measures whichever build happened to be lying
    // around, which on a stale checkout is a different product.
    "@engine/inventory#test": {
      "dependsOn": ["^build", "@engine/space#build"],
      "outputs": ["coverage/**"]
    },
    // The reference app runs the same sweep over its own routes, so it needs
    // the same stylesheet — one guard asked of one product is the one that gets
    // waived.
    "@engine/hello#test": {
      "dependsOn": ["^build", "@engine/space#build"],
      "outputs": ["coverage/**"]
    },
    // ⚠️ AND THE SPACE MEASURES ITS OWN FRAME, so it needs its own stylesheet —
    // the one case where the edge is to the package's OWN build. Turbo has no
    // way to express that, and it does not need to: the task depends on the
    // build task of the same package, which it already orders.
    "@engine/space#test": {
      "dependsOn": ["^build", "@engine/space#build"],
      "outputs": ["coverage/**"]
    },
    "@kova/api#test": {
      "dependsOn": ["^build", "@kova/app#build"],
      "outputs": ["coverage/**"]
    },
    "@4dl/template#test": {
      // The template serves `apps/_template-app/dist` too, and gets the same
      // hand-declared edge as the three products — because the whole point of a
      // template is that a copy of it inherits the wiring that is easy to
      // forget. A new app renamed from this one keeps the pattern; one that
      // started from a product would have had to notice this line.
      "dependsOn": ["^build", "@4dl/template-app#build"],
      "outputs": ["coverage/**"]
    },
    "@4dl/scena#test": {
      // Scena's worker serves `apps/scena-app/dist` through an `assets`
      // binding, and an `assets.directory` is a filesystem path, not a package
      // dependency — turbo cannot infer this edge. Without the build, Miniflare
      // aborts and reports "no tests", which reads as a pass. Declaring it by
      // hand is the same fix `@kova/api` needed.
      "dependsOn": ["^build", "@scena/app#build"],
      "outputs": ["coverage/**"]
    },
    "e2e": {
      // Every worker serves its app's `dist` through an `assets` binding, which
      // is a filesystem path and NOT a package dependency — turbo cannot infer
      // it. A missing build here does not fail loudly; it serves a stale shell
      // or none, and the suite reports "element not found".
      //
      // `@scena/player#build` is NOT here, deliberately: the Scena suite builds
      // the player itself, inside its webServer command, because `VITE_API_BASE`
      // has to be baked in at build time and has to name the port that suite
      // owns. A turbo-built player would carry the production origin.
      "dependsOn": ["@kova/app#build", "@scena/app#build"],
      "cache": false,
      // Turbo filters the environment. Playwright locates its browsers through
      // PLAYWRIGHT_BROWSERS_PATH (pre-set on CI images and sandboxes); stripped,
      // it reports "please run playwright install" and every spec fails.
      "passThroughEnv": ["PLAYWRIGHT_*", "CI", "E2E_SERVER_LOGS", "NODE_OPTIONS"]
    },
    // The screenshot sweep serves the same built SPA, and it PHOTOGRAPHS it —
    // so a stale `dist` here does not fail, it produces convincing pictures of
    // the previous design and files them under the current names. That happened
    // once, silently, and it is the worst failure mode available to a suite
    // whose whole job is evidence.
    "shots": {
      "dependsOn": ["@kova/app#build"],
      "cache": false,
      "passThroughEnv": ["PLAYWRIGHT_*", "CI", "E2E_SERVER_LOGS", "NODE_OPTIONS"]
    },
    /*
      ⚠️ SAME TRAP AS THE WORKER SUITES, one door further along.

      Scena's screenshot run boots TWO workers: the dashboard (assets →
      `apps/scena-app/dist`) and the PLAYER (assets → `apps/scena-player/dist`).
      An `assets.directory` is a filesystem path, not a package dependency, so
      turbo cannot infer either edge — and the generic `shots` task above names
      only Kova's SPA.

      Unbuilt, `wrangler dev` refuses to start at all and Playwright reports
      "Process from config.webServer was not able to start", which names neither
      the app nor the missing directory. That is what happened the first time
      this ran after the UI work; the pictures were not stale, they did not
      exist.
    */
    "@scena/e2e#shots": {
      "dependsOn": ["@scena/app#build", "@scena/player#build"],
      "cache": false,
      "passThroughEnv": ["PLAYWRIGHT_*", "CI", "E2E_SERVER_LOGS", "NODE_OPTIONS"]
    },
    "@scena/e2e#test": {
      "dependsOn": ["@scena/app#build", "@scena/player#build"],
      "cache": false,
      "passThroughEnv": ["PLAYWRIGHT_*", "CI", "E2E_SERVER_LOGS", "NODE_OPTIONS"]
    },
    "@4dl/core#build": { "outputs": [] },
    "@4dl/tenancy#build": { "outputs": [] },
    "@4dl/auth#build": { "outputs": [] },
    "@4dl/billing#build": { "outputs": [] },
    "@4dl/commerce#build": { "outputs": [] },
    "@4dl/storage#build": { "outputs": [] },
    "@4dl/ai#build": { "outputs": [] },
    "@4dl/email#build": { "outputs": [] },
    "@4dl/notify#build": { "outputs": [] },
    "@4dl/purge#build": { "outputs": [] },
    "@kova/domain#build": { "outputs": [] },
    "@kova/protocol#build": { "outputs": [] },
    "@4dl/ui#build": { "outputs": [] },
    "@4dl/app-kit#build": { "outputs": [] },
    "lint": {},
    "dev": {
      "cache": false,
      "persistent": true
    },
    "clean": {
      "cache": false
    }
  }
}
