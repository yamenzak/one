{
  "name": "kova",
  "private": true,
  "version": "0.0.0",
  "description": "Multi-tenant, multi-trainer personal-training platform on the Cloudflare stack",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "turbo run build --filter='./engine/*' --filter='./engine/apps/*'",
    "dev": "pnpm engine:dev",
    "test": "pnpm gate && pnpm engine:test",
    "gate": "node .github/workflows/workflows-parse.test.mjs && pnpm engine:gate",
    "typecheck": "pnpm engine:typecheck",
    "clean": "turbo run clean && rm -rf node_modules",
    "engine:dev": "turbo run dev --filter='./engine/*'",
    "engine:test": "turbo run test --filter='./engine/*' --filter='./engine/apps/*'",
    "engine:typecheck": "turbo run typecheck --filter='./engine/*' --filter='./engine/apps/*'",
    "engine:gate": "node engine/scripts/gate.mjs"
  },
  "devDependencies": {
    "turbo": "^2.5.9",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
