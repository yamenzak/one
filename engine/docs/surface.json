      "retryable": false
    },
    {
      "code": "platform.not_found",
      "status": 404,
      "title": "That is not here",
      "tone": "neutral",
      "retryable": false
    },
    {
      "code": "platform.conflict",
      "status": 409,
      "title": "Something else changed first",
      "tone": "warning",
      "retryable": false
    },
    {
      "code": "platform.maintenance",
      "status": 503,
