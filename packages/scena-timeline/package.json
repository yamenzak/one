{
  "name": "@scena/timeline",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Pure, zero-dependency clock + timeline engine. The heart of Scena. Runs byte-identically in the manifest compiler, the player, and tests.",
  "exports": {
    ".": "./src/index.ts"
  },
  "types": "./src/index.ts",
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "build": "tsc --noEmit",
    "clean": "rm -rf .turbo coverage *.tsbuildinfo"
  },
  "devDependencies": {
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
