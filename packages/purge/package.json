{
  "name": "@4dl/purge",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Erasure derived from the schema: the tenant and subject delete cascades come from each module's `scoped` declaration, and a conformance check refuses a scoped table nobody declared.",
  "exports": {
    ".": "./src/index.ts",
    "./model": "./src/model.ts"
  },
  "types": "./src/index.ts",
  "scripts": {
    "test": "vitest run --passWithNoTests",
    "typecheck": "tsc --noEmit",
    "build": "tsc --noEmit",
    "clean": "rm -rf .turbo *.tsbuildinfo"
  },
  "dependencies": {
    "@4dl/core": "workspace:*"
  },
  "devDependencies": {
    "@4dl/core": "workspace:*",
    "@cloudflare/workers-types": "^4.20251001.0",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
