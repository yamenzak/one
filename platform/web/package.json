{
  "name": "@one/web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "The platform's own screens, in the browser. Every app mounts these; components are extracted out of them as a second use appears, never before.",
  "exports": {
    ".": "./src/index.ts"
  },
  "types": "./src/index.ts",
  "scripts": {
    "test": "node ../scripts/sheets.mjs src && vitest run --passWithNoTests",
    "typecheck": "tsc --noEmit",
    "build": "tsc --noEmit",
    "clean": "rm -rf .turbo *.tsbuildinfo",
    "page": "tsx dev/page.tsx"
  },
  "devDependencies": {
    "@dicebear/core": "^10.4.0",
    "@dicebear/styles": "^10.4.0",
    "@one/deployment": "workspace:*",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.0",
    "esbuild": "^0.25.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "simple-icons": "^16.28.0",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  },
  "peerDependencies": {
    "react": ">=19"
  },
  "dependencies": {
    "@one/kernel": "workspace:*",
    "@radix-ui/react-avatar": "^1.1.10",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-visually-hidden": "^1.2.3",
    "lucide-react": "^1.31.0"
  }
}
