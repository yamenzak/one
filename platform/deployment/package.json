{
  "name": "@one/deployment",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "WHO RUNS THIS DEPLOYMENT — the one thing in platform/ that is not product-agnostic. Every worker imports it; no shared package may.",
  "exports": { ".": "./src/index.ts" },
  "types": "./src/index.ts",
  "scripts": {
    "test": "vitest run --passWithNoTests",
    "typecheck": "tsc --noEmit",
    "build": "tsc --noEmit",
    "clean": "rm -rf .turbo *.tsbuildinfo"
  },
  "dependencies": { "@one/kernel": "workspace:*" },
  "devDependencies": { "typescript": "^5.9.3", "vitest": "^3.2.4" }
}
