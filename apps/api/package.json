    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "0.8.55",
    "@cloudflare/workers-types": "^4.20251001.0",
    "@simplewebauthn/server": "13.3.2",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4",
    "wrangler": "^4.42.0"
  }
