{
  // Kova edge API — Workers + TenantBillingDO. One worker serves the
  // role-adaptive app (static assets) AND the API at the same origin, so the
  // Better Auth session cookie is same-origin — no CORS/credentials juggling
  // (SPEC §3). KV/D1/R2 ids below are placeholders; local `wrangler dev`
  // simulates everything. Real ids only needed for a remote deploy.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "kova",
  "main": "src/index.ts",
  "compatibility_date": "2025-07-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },

  // Serve the built app SPA from the edge; the Worker runs first for the API
  // surface, SPA fallback for client-side routes. Build the app before
  // deploying: `pnpm --filter @kova/app build`.
  "assets": {
    "directory": "../app/dist",
    "not_found_handling": "single-page-application",
    // No HTML path rewriting. The default, "auto-trailing-slash", answers
    // `/index.html` with a 307 to `/` — and a 307 is poison to a service
    // worker: the navigation fallback fetches the shell on a precache miss, and
    // a navigation cannot be answered with a redirected response, so every deep
    // link (/admin, /settings, …) died as ERR_FAILED while `/` kept working.
    // This app has exactly one HTML file and does its own routing, so there is
    // nothing for the redirect logic to help with. `/` and every client-side
    // route still resolve — through `not_found_handling` above, which serves
    // the shell with a 200 and no redirect.
    "html_handling": "none",
    "run_worker_first": ["/api/*", "/health", "/manifest.webmanifest"]
  },

  /**
   * NO `routes` HERE — on purpose, and this is load-bearing for local dev.
   *
   * The two patterns this worker needs are:
   *
   *   kova.4dl.app/*     the root (a signpost), `setup.`, `admin.`
   *   *.kova.4dl.app/*   every studio's subdomain
   *
   * and they are created ONCE in the Cloudflare dashboard (DEPLOY.md §11 Step C),
   * not from here. Two reasons:
   *
   *  1. **Declaring routes breaks `wrangler dev`.** With a `routes` entry, the dev
   *     server discards the incoming Host and rewrites every request to the route's
   *     hostname — verified: `Host: acme.localhost:8787` arrives at the worker as
   *     `http://kova.4dl.app/…`, with `mf-original-hostname` rewritten too, so the
   *     original is not recoverable. Kova resolves the TENANT from the Host, so that
   *     collapses every door onto the root: `pnpm dev` serves a dead-end signpost
   *     and no studio subdomain can be reached or tested. Removing the block
   *     restores pass-through, and dev/E2E then exercise the shipped topology.
   *  2. **A route alone is worse than no route.** `*.kova.4dl.app` is a
   *     SECOND-level wildcard, which Universal SSL does not cover (it terminates
   *     one level: `*.4dl.app`). It needs an ACM certificate and a proxied wildcard
   *     DNS record, and if the route exists without them every studio subdomain
   *     fails the TLS handshake before the worker runs — "all studios down" on a
   *     green deploy. Keeping all three together in one dashboard checklist makes
   *     that impossible to do by halves.
   *
   * Custom domains are unaffected: those routes are created per-hostname through
   * the Cloudflare API at bind time (cloudflare.ts `createWorkerRoute`), because
   * Cloudflare matches routes on the incoming Host and a tenant's own domain is not
   * in this zone. Route management outside wrangler is already the pattern here.
   *
   * `wrangler deploy` does not remove routes it does not declare, so deploys are
   * safe once the two above exist.
   */

  // 15-min tick: reminder/notification sweeps. Daily 00:10 UTC: monthly credit
  // grants + platform dunning lifecycle (SPEC §3). No domain cron — client
  // subscription expiry is derived at read time.
  "triggers": { "crons": ["*/15 * * * *", "10 0 * * *", "0 8 * * 1"] },

  "vars": {
    // Platform super-admin allowlist (separate axis from tenant RBAC).
    "ADMIN_EMAILS": "zakhouryamen@gmail.com",
    // Public origin of the ROOT door. Better Auth's baseURL is per-request (the
    // hostname the user actually came through), so this is only the advertised
    // canonical origin and the fallback for background jobs with no request.
    "BETTER_AUTH_URL": "https://kova.4dl.app",
    // The apex studios live under. Every hostname is classified against it, it is
    // the WebAuthn RP ID and the session cookie's Domain for every door beneath it,
    // and `<slug>.ROOT_DOMAIN` is a studio's address. Set explicitly: deriving it
    // silently reclassifies every studio subdomain as a foreign custom domain,
    // which fails closed as "every studio 404s" with nothing naming the cause.
    "ROOT_DOMAIN": "kova.4dl.app"
    // BETTER_AUTH_SECRET is a wrangler secret (openssl rand -base64 32).
  },

  // Workers AI — the AI suite's default lane (SPEC §6). env.AI is optional; the
  // deterministic mock covers local dev without credentials. For a fully
  // credential-free `wrangler dev` you can re-comment this line.
  "ai": { "binding": "AI" },

  "durable_objects": {
    "bindings": [
      { "name": "BILLING", "class_name": "TenantBillingDO" },
      { "name": "INBOX", "class_name": "InboxDO" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["TenantBillingDO"] },
    { "tag": "v2", "new_sqlite_classes": ["InboxDO"] }
  ],

  "kv_namespaces": [
    // External food/exercise API response cache + short-lived tokens.
    { "binding": "CACHE", "id": "d45cc2d0725d4d9aab13c247f2a27e1a" },
    // The SHARED platform config store — the SAME namespace id in every 4DL
    // app, holding the credentials the whole platform has in common (the
    // Google key, the Stripe account, the Cloudflare token, the Turnstile
    // widget). This app's own `app_config` rows still win. Written here by
    // provisioning; see packages/core/src/config.ts.
    { "binding": "PLATFORM_CONFIG", "id": "c851c1a484c444cd91c5be8766d9256d" }
  ],

  "d1_databases": [
    // Everything relational: Better Auth, tenants' coaching data, billing
    // mirrors. Local wrangler dev simulates this.
    //
    // `database_name` is deliberately ABSENT. D1 has no rename API, so the name a
    // database was created under is permanent — and this one predates the rename.
    // Recording that stale name here would have been the only place the old
    // product name survived, and it buys nothing: the binding resolves purely by
    // `database_id` (verified — `wrangler deploy --dry-run` binds `env.DB` with no
    // name present and raises no warning), and the CLI takes the BINDING as its
    // target, so `wrangler d1 execute DB --remote …` works on any account no
    // matter what the underlying database is called. DEPLOY.md uses that form
    // throughout for the same reason.
    //
    // Keeping this id rather than creating a fresh database is deliberate: it
    // carries the platform config (Gemini key, email provider, Cloudflare-for-SaaS
    // token, Turnstile keys) that a nuclear reset preserves.
    { "binding": "DB", "database_id": "33ef2469-908b-4fac-816e-5d122c15aed1" }
  ],

  "r2_buckets": [
    // Media library: exercise media, food images, progress photos (private,
    // served via authed proxy), lab uploads, avatars, AI assets.
    { "binding": "MEDIA", "bucket_name": "kova-media" }
  ],

  // Cloudflare Email Sending (transactional: OTP codes, invites, notices).
  // Until the sender domain is onboarded the mailer falls back to a dev mock.
  "send_email": [{ "name": "EMAIL" }]
}
