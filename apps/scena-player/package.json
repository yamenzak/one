{
  "name": "@scena/player",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Scena screen player \u2014 a framework-light Vite PWA. Pairs a screen, syncs the clock, and drives clock-synced playout from the timeline engine.",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf .turbo dist *.tsbuildinfo"
  },
  "dependencies": {
    "@scena/brand": "workspace:*",
    "@scena/manifest": "workspace:*",
    "@scena/protocol": "workspace:*",
    "@scena/timeline": "workspace:*",
    "@scena/widgets": "workspace:*"
  },
  "devDependencies": {
    "typescript": "^5.9.3",
    "vite": "^6.3.4",
    "wrangler": "^4.42.0"
  }
}
