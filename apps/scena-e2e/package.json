{
  "name": "@scena/e2e",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "Playwright E2E for Scena — pair, publish, and two screens on the same frame, driven through the real app at :8789.",
  "scripts": {
    "e2e": "NODE_OPTIONS=--disable-warning=ExperimentalWarning playwright test",
    "e2e:ui": "NODE_OPTIONS=--disable-warning=ExperimentalWarning playwright test --ui",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf .turbo playwright-report test-results *.tsbuildinfo"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "@types/node": "^22.20.1",
    "typescript": "^5.9.3"
  }
}
