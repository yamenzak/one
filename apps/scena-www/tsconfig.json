{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "target": "es2022",
    "lib": ["es2022", "dom"],
    "types": ["node"],
    "skipLibCheck": true
  },
  "//": "build.mjs is @ts-nocheck (it reaches into cross-package TS sources under tsx); only the pure src modules are type-checked.",
  "include": ["src/**/*.mjs"]
}
