{
  "name": "@kova/e2e",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "Playwright E2E — the golden paths (SPEC §12). Drives the built SPA that `wrangler dev` serves at :8787.",
  "scripts": {
    "e2e": "NODE_OPTIONS=--disable-warning=ExperimentalWarning playwright test",
    "e2e:ui": "NODE_OPTIONS=--disable-warning=ExperimentalWarning playwright test --ui",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf .turbo playwright-report test-results *.tsbuildinfo",
    "shots": "NODE_OPTIONS=--disable-warning=ExperimentalWarning playwright test --config shots.config.ts"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "@types/node": "^22.20.1",
    "typescript": "^5.9.3"
  }
}
